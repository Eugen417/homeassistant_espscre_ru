    "alerts": {
      "fields": {
        "title": {
          "label": "Title",
          "help": "A single line at the top of the card; what doesn't fit gets an ellipsis. Empty becomes \"Notification\".",
          "example": "Someone is at the door"
        },
        "subtitle": {
          "label": "Subtitle",
          "help": "Explanation under the title, across multiple lines; a line break is fine. Empty is fine.",
          "example": "Door 3, back"
        },
        "icon": {
          "label": "Icon",
          "help": "A name from the list, also as mdi:name or as a hex codepoint (F12E6). Unknown or empty gives the warning triangle."
        },
        "color": {
          "label": "Color",
          "help": "One of the nine pastel colors of the tiles. Empty gives the white card."
        },
        "button_text": {
          "label": "Button text",
          "help": "The text on the button. Empty is \"OK\".",
          "example": "Coming"
        },
        "timeout": {
          "label": "Timeout",
          "help": "Seconds after which the card disappears on its own. 0 waits for the button, however long that takes. The button always closes it immediately, even with a timeout."
        },
        "flash": {
          "label": "Blinking",
          "help": "On makes the backlight blink four times when the alert arrives; the screen then just stays on."
        },
        "camera": {
          "label": "Camera",
          "help": "A camera or image entity. A Guition with firmware 0.2.57+ shows its picture of that moment across the top of the card; a tap on it opens the camera full screen. Other screens show the alert without it. Only through the esp_screens_show_alert event."
        }
      },
      "endings": {
        "ok": "The button was pressed",
        "timeout": "The timeout ran out",
        "replaced": "A new alert came over it",
        "remote": "dismiss_alert from Home Assistant"
      }
