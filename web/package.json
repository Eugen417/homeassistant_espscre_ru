{
  "name": "esp-screens-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "devEngines": {
    "runtime": { "name": "node", "version": "^20.19.0 || >=22.12.0", "onFail": "error" }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && rm -rf ../screen_manager/app/static/assets && vite build",
    "check": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "vue": "^3.5.18",
    "vue-i18n": "^11.4.12"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.0.6"
  }
}
