# Gitignore settings for ESPHome
# This is an example and may include too much for your use-case.
# You can modify this file to suit your needs.
/.esphome/
/secrets.yaml
# The owner's bench entries: the boards' own names, keys and calibration, never in Git.
/guition-wallbox.yaml
/cyd-2432s028.yaml


# Personal device configuration (not part of the example)
testdevice.yaml

# Handmatige backups van de config
*.yaml.bak*

# Local rollback binaries and diagnostic captures
/diagnostics/*.bin
/diagnostics/*.log

# Python caches from local ESPHome components
__pycache__/
*.pyc

# Per-owner onboarding files and share bundles
/device.yaml
/calibration.yaml
/calibration.proposed.yaml
/measurements*.json
/dist/
/.venv/

# Local editor state and measurement/temporary outputs
/.idea/
/calibration*.yaml.bak-*
/calibration*.yaml.tmp-*
/.DS_Store

/guition-device.yaml

/diagnostics/*.png
/.venv-portal/
/easy-guition-device.yaml
/easy-cyd-test.yaml
/portal-test-data/

# Boards tried out in the responsive lab (tools/new_board.py, docs/RESPONSIVE.md) stay on this machine; the cards
# of their grids are written with `tools/generate_cells.py --lab` and are not ignored, so a board that ships
# never has its cards left out of Git.
packages/boards/lab-*.yaml
